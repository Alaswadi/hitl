PORT=9999

# -----------------------------------------------------------------------
# Facebook
# -----------------------------------------------------------------------
# Verification token you set in the Meta App dashboard
FB_VERIFY_TOKEN=mosaaedak-tok

# Your Meta App Secret (used to verify X-Hub-Signature-256 on each webhook)
FB_APP_SECRET=your_fb_app_secret_here

# -----------------------------------------------------------------------
# Mosaaedak API (this gateway calls Mosaaedak to fetch tenant config)
# -----------------------------------------------------------------------
MOSAAEDAK_API_URL=https://api.mosaaedak.com
MOSAAEDAK_API_KEY=sk_02379b6024b14e1fafba2dd265229653

# -----------------------------------------------------------------------
# OpenRouter (AI)
# -----------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here

# -----------------------------------------------------------------------
# WhatsApp (TextMeBot) webhook security
# Set the TextMeBot webhook URL in each tenant's account to:
#   https://<your-gateway>/whatsapp/webhook?token=<WHATSAPP_WEBHOOK_SECRET>
# -----------------------------------------------------------------------
WHATSAPP_WEBHOOK_SECRET=change_this_to_a_strong_random_secret

# -----------------------------------------------------------------------
# HITL Settings
# -----------------------------------------------------------------------
HITL_TIMEOUT_MINUTES=30
COST_PER_MESSAGE=0.03
